```gitignore
# Compiled and binary files
*.exe
*.dll
*.so
*.class
*.pyc
__pycache__/

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/
*.out
*.obj

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors and IDEs
.vscode/
.idea/
*.swo

# System files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
.mypy_cache/
.pytest_cache/

# Java specific
.gradle/
*.jar

# Compression and archives
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```